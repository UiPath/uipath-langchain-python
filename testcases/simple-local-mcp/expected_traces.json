            "How is the weather today in New York?"
          ]
        }
      }
    },
    {
      "name": "Model run",
      "span_type": "completion",
      "parent_name": "model",
      "attributes": {
        "output": {
          "contains": "name=get_weather"
        }
      }
    }
  ]
