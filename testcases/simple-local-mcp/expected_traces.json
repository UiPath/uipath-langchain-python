      "attributes": {
        "openinference.span.kind": "CHAIN",
        "session.id": "default"
      }
    },
    {
      "name": "get_weather",
      "parent_name": "tools",
      "attributes": {
        "openinference.span.kind": "TOOL",
        "tool.name": "get_weather",
        "tool.description": "Get weather for location.",
