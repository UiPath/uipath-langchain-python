# Copy to .env, then run `uipath auth`: it writes UIPATH_URL, UIPATH_ACCESS_TOKEN,
# UIPATH_TENANT_ID and UIPATH_ORGANIZATION_ID into .env and keeps the settings below.

# Serve ./skills through the Skills API client, without a Skills API server.
# `local` copies the folder directly instead.
UIPATH_SKILLS_SOURCE=mock
UIPATH_SKILLS_MOCK_ROOT=./skills
UIPATH_FOLDER_PATH=Shared/Skills
