# Copy to .env, then run `uipath auth`: it writes UIPATH_URL, UIPATH_ACCESS_TOKEN,
# UIPATH_TENANT_ID and UIPATH_ORGANIZATION_ID into .env and keeps the settings below.

# Read the bundles from ./skills. `orchestrator` is a placeholder until the
# Orchestrator Skills API ships: it skips every bundle.
UIPATH_SKILLS_SOURCE=local
